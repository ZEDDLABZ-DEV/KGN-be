{
  "name": "cicp",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc",
    "watch": "tsc -w",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:setup": "npm run db:up && npm run prisma:generate && npm run prisma:migrate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "microservices:dev": "nodemon microservices/server.ts",
    "microservices:build": "rimraf microservices/dist && tsc -p microservices/tsconfig.json",
    "microservices:watch": "tsc -p microservices/tsconfig.json -w",
    "microservices:start": "node -r tsconfig-paths/register microservices/dist/server.js",
    "microservices:seed": "ts-node microservices/prisma/seed.ts",
    "microservices:studio": "prisma studio microservices"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@types/multer": "^2.0.0",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "openai": "^6.14.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.2",
    "@types/pino": "^7.0.5",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
