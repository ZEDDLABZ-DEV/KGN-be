# Copy to .env for local development:
#   cp .env.example .env
#
# .env is gitignored — production/dev servers use their own env vars.

NODE_ENV=development
PORT=3000

# Local PostgreSQL (matches docker-compose.yml — start with: npm run db:up)
DATABASE_URL="postgresql://kgnapp_user:KgnAppAksh1@127.0.0.1:5432/kgnapp_db?schema=public"

# Must differ from production and development server secrets
JWT_SECRET=your-local-jwt-secret

# Optional — only needed for AI/BOQ features
OPENAI_API_KEY=

# AWS — leave AWS_S3_PREFIX=local-dev locally so uploads don't touch prod files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=kgn-project-bucket
AWS_S3_PREFIX=local-dev
