# Copy to .env for local development:
#   cp .env.example .env
#
# .env is gitignored. Production supplies these values as environment variables.
# Do not put real database, JWT, AWS, or admin credentials in this file.

NODE_ENV=production
PORT=3000

# Supabase session pooler (port 5432). Replace USER, PASSWORD, and HOST.
# sslmode and connection_limit belong on this URL. Do not set PORT to 5432.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connection_limit=5"

JWT_SECRET="replace-with-secure-secret"

# Used only by `npm run create:admin`. Leave empty until you run that script.
# ADMIN_PHONE is required because User.phone is unique and non-null.
# ADMIN_GENDER is optional and defaults to OTHER.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ADMIN_PHONE=""
ADMIN_GENDER=""

# Optional — only needed for AI/BOQ features
OPENAI_API_KEY=

# AWS S3 — required only for file upload features
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=kgn-project-bucket
AWS_S3_PREFIX=local-dev
